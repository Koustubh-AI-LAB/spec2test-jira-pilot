# State Service.
#
# Two DSNs on purpose: the app connects as a constrained role that cannot
# rewrite audit_event, while migrations run as the owner. One DSN for both
# would make the append-only guarantee decorative.
DATABASE_URL=postgresql://spec2test_app:spec2test_app@localhost:5435/spec2test
MIGRATION_DATABASE_URL=postgresql://spec2test:spec2test@localhost:5435/spec2test
PORT=8787

# Jira - the service owns all Jira I/O, one auth path.
#
# The token must be a CLASSIC API token, not a scoped one. Atlassian offers
# both and they are not interchangeable:
#   - classic  -> carries your full user permissions, authenticates against
#                 JIRA_BASE_URL. Required: creating custom fields and projects
#                 needs admin, which no scoped token grants.
#   - scoped   -> only authenticates against api.atlassian.com/ex/jira/<cloudId>
#                 and 401s on the site URL. Read paths work; admin does not.
# The client probes both hosts at startup and uses whichever answers, so a
# scoped token still drives the read/reconcile path. Note that
# /rest/api/3/mypermissions reports the USER's permissions, not the token's
# scopes - it will claim ADMINISTER=true for a token that cannot create a field.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Only needed for a scoped token, to build the gateway URL.
JIRA_CLOUD_ID=

# Custom field ids are per-site; these are the pilot site's. The four fields are
# the PO's Gate 1 surface, and Verification Status is the approval signal:
# setting it to "Criteria Approved" is what closes Gate 1.
JIRA_FIELD_VERIFICATION_STATUS=customfield_10107
JIRA_FIELD_CRITERIA_CERTIFIED=customfield_10108
JIRA_FIELD_CRITERIA_TOTAL=customfield_10109
JIRA_FIELD_LAST_VERIFIED=customfield_10110

# Fixture ticket the live Jira tests run against. They mutate it and reset it,
# so it must not be a real ticket.
JIRA_TEST_ISSUE=S2T-1

# Target app: self-hosted Conduit (gothinkster/node-express-realworld-example-app,
# forked to your own GitHub account), step 3 of the build order. runner/'s
# live e2e test is skipped entirely when CONDUIT_BASE_URL is unset.
CONDUIT_BASE_URL=
# Absolute path to the local Conduit clone - runner/'s `init` and e2e test
# need it to know where to scaffold spec2test/ and write generated tests.
CONDUIT_REPO_PATH=

# Target app auth (single role for the pilot; injected by the runner's client
# wrapper). Cheap form of day-one item #16: a single static bearer token, not
# a per-test login flow. Mint one by registering a fixture user against your
# running Conduit instance and copying its `token` here; re-mint the same way
# if it ever fails with 401. This same value also needs to live in Conduit's
# own .env (gitignored there too) so generated tests can run standalone via
# that repo's own `npx playwright test`.
TARGET_AUTH_TOKEN=
