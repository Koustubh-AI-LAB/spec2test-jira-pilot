{
  "criterionId": "C-LOGIN-WRONG-PASSWORD",
  "name": "reject login with the wrong password",
  "method": "POST",
  "path": "/api/users/login",
  "auth": "none",
  "body": {
    "user": {
      "email": "spec2test_login_fixture@spec2test.dev",
      "password": "WrongPassword!"
    }
  },
  "assertions": [
    { "name": "status_403", "check": "status === 403" },
    { "name": "has_error", "check": "body.errors" }
  ]
}
